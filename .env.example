# Copy to .env.local for development. In production set these in Vercel → Settings → Environment Variables.

# Postgres / Neon connection string (use the pooled connection string from Neon).
# For local development without Postgres, the embedded database is used:
DATABASE_URL=pglite:./.data/pglite
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Canonical public URL. QR codes and email links are built from this — set it to the production domain.
APP_URL=http://localhost:3000

# Random secrets — generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Encrypts storage credentials saved in the admin. Never change it after saving credentials (they become unreadable).
SETTINGS_ENCRYPTION_KEY=

# Cloudflare Turnstile. The values below are Cloudflare's always-pass TEST keys — replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend. Leave empty in development to log emails to the console instead of sending.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Recruitment <jobs@your-domain.co.uk>

# Protects /api/cron/retention (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# Local-disk file storage for development/testing only. Refused on Vercel.
ALLOW_LOCAL_STORAGE=false

# Set to true temporarily to send CSP as Content-Security-Policy-Report-Only while troubleshooting.
CSP_REPORT_ONLY=false
